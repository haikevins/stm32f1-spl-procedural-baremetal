*.o
*.d
*.su
*.a
*.elf
*.hex
*.bin
*.map
*.lst

# Debugger and coverage files
*.gdb_history
*.gcda
*.gcno

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db
